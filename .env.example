# Copy to .env (ignored by Git) and set a password. Docker Compose reads these
# values to create the database, and the application connects with the same
# standard PostgreSQL variables: `uv run --env-file .env ...`.
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=personal_finance
PGDATABASE=personal_finance
PGPASSWORD=

# Database for tests that need PostgreSQL; they are skipped when this is unset.
PERSONAL_FINANCE_TEST_DATABASE=personal_finance_test
